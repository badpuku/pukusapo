{
  "name": "pukusapo",
  "private": true,
  "workspaces": [
    "frontend",
    "automation",
    "supabase"
  ],
  "scripts": {
    "dev": "npm run dev -w frontend",
    "dev:automation": "npm run dev -w automation",
    "build": "npm run build -w frontend",
    "deploy": "npm run deploy -w frontend",
    "deploy:dev": "npm run deploy:dev -w frontend",
    "db:start": "npm run start -w supabase",
    "db:stop": "npm run stop -w supabase",
    "db:reset": "npm run reset -w supabase",
    "db:migrate": "npm run migrate -w supabase",
    "db:gen-types": "npm run gen-types -w supabase > frontend/app/models/supabase.ts",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "engines": {
    "node": ">=20.18.0"
  },
  "volta": {
    "node": "20.18.0"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^6.7.4",
    "@typescript-eslint/parser": "^6.7.4",
    "eslint": "^8.38.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-import": "^2.28.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "typescript": "^5.7.3"
  }
}
